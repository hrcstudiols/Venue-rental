# Copy to .env and fill in values. Never commit .env or credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
ADMIN_TOKEN="replace-with-a-long-random-secret"

# Optional until Google Calendar is configured. Share the target calendar with the
# service-account email as an editor. Keep the private key secret.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID=""
